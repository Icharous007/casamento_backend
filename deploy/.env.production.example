# Copy this file to /opt/casamento/.env on the server. Do not commit that file.
BACKEND_IMAGE=casamento-backend:2026-09-06

DB_NAME=casamento
DB_USERNAME=casamento
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

JWT_ISSUER=https://gustavoemalucasam.net.br
APP_BASE_URL=https://gustavoemalucasam.net.br
APP_FRONTEND_URL=https://gustavoemalucasam.net.br
APP_TIMEZONE=America/Sao_Paulo
APP_CONFIRMATION_PHRASE=REPLACE_WITH_A_PRIVATE_CONFIRMATION_PHRASE

R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=REPLACE_WITH_PRODUCTION_R2_ACCESS_KEY
R2_SECRET_KEY=REPLACE_WITH_PRODUCTION_R2_SECRET_KEY
R2_BUCKET=casamento-media-prod
R2_REGION=auto
R2_PUBLIC_BASE_URL=
R2_API_CALL_TIMEOUT=PT30S
R2_API_ATTEMPT_TIMEOUT=PT10S
R2_CONNECTION_TIMEOUT=PT5S
R2_SOCKET_TIMEOUT=PT20S
R2_UPLOAD_URL_TTL=PT10M

# Set both values before disabling public R2 access. MEDIA_DELIVERY_BASE_URL is
# the route of deploy/cloudflare/media-worker, not the R2 custom domain.
MEDIA_DELIVERY_BASE_URL=https://media.gustavoemalucasam.net.br
MEDIA_DELIVERY_SIGNING_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MEDIA_DELIVERY_URL_TTL=PT5M
MEDIA_REQUIRE_PRIVATE_DELIVERY=true
MEDIA_MAX_PENDING_UPLOADS_PER_GUEST=3

# The frontend and API share one HTTPS origin; retain this explicit production value.
CORS_ALLOWED_ORIGINS=https://gustavoemalucasam.net.br
JOB_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional but strongly recommended. Example: casamento-backups:postgres
BACKUP_RCLONE_DEST=